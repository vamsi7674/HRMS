# ============ Local Deploy Stage ============
# This Dockerfile is used by docker-compose to run the JAR
# that has already been built by Jenkins (mvn clean package)

FROM eclipse-temurin:17-jre-alpine

WORKDIR /app

# Set timezone to IST
ENV TZ=Asia/Kolkata
RUN apk add --no-cache tzdata && \
    cp /usr/share/zoneinfo/Asia/Kolkata /etc/localtime && \
    echo "Asia/Kolkata" > /etc/timezone && \
    apk del tzdata

# Copy the built JAR from the Jenkins deploy directory
COPY Workforce-0.0.1-SNAPSHOT.jar app.jar

EXPOSE 8080

ENV SPRING_PROFILES_ACTIVE=prod
ENV JAVA_OPTS="-Xms256m -Xmx512m -Duser.timezone=Asia/Kolkata"

ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar app.jar"]
